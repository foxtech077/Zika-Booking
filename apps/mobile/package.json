{
  "name": "@zika/mobile",
  "version": "0.0.5",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-experimental-require-module expo start",
    "web": "cross-env NODE_OPTIONS=--no-experimental-require-module expo start --web --port 3000",
    "dev:tunnel": "cross-env NODE_OPTIONS=--no-experimental-require-module expo start --tunnel",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "typecheck": "tsc --noEmit",
    "postinstall": "pnpm --filter @zika/types --filter @zika/validators build"
  },
  "dependencies": {
    "@expo/metro-runtime": "^6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-firebase/app": "^21.8.0",
    "@react-native-firebase/messaging": "^21.14.0",
    "@react-native-google-signin/google-signin": "^13.1.0",
    "@stripe/stripe-react-native": "^0.50.3",
    "@tanstack/react-query": "^5.65.1",
    "@zika/types": "workspace:*",
    "@zika/validators": "workspace:*",
    "axios": "^1.7.9",
    "expo": "~54.0.34",
    "expo-apple-authentication": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-document-picker": "~14.0.8",
    "expo-font": "~14.0.11",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.23",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "^2.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-get-random-values": "^1.11.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-maps": "^1.20.1",
    "react-native-safe-area-context": "5.6.2",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "^0.21.2",
    "react-native-webview": "13.15.0",
    "zod": "^3.24.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@types/react": "~19.1.17",
    "@types/react-dom": "~19.1.11",
    "cross-env": "^10.1.0",
    "tailwindcss": "3.3.2",
    "typescript": "^5.7.3"
  }
}
