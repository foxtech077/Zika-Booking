{
  "expo": {
    "name": "kainook",
    "slug": "kainook",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kainook",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a73e8"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kainook.app",
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "associatedDomains": [
        "applinks:kainook.com",
        "webcredentials:kainook.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a73e8"
      },
      "package": "com.kainook.app",
      "googleServicesFile": "./google-services.json",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kainook.com",
              "pathPrefix": "/verify"
            },
            {
              "scheme": "https",
              "host": "kainook.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "kainook.com",
              "pathPrefix": "/auth/verify"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-apple-authentication"
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.397191986681-40j0eqotdon89ogv4cgvfsfpb48ehc7h"
        }
      ],
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.kainook.app"
        }
      ]
    ],
    "updates": {
      "enabled": false
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "22abc754-57bc-4ca3-bb77-9c0b9846f249"
      }
    }
  }
}
