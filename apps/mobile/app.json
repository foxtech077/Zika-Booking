{
  "expo": {
    "name": "Kainook",
    "slug": "kainook",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kainook",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kainook.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSLocationWhenInUseUsageDescription": "Kainook uses your location to place your listing's map pin accurately when you are at the property.",
        "NSCameraUsageDescription": "Kainook requires camera access to allow you to take and upload a profile picture, as well as take photos of your property or vehicle when creating a listing.",
        "NSPhotoLibraryUsageDescription": "Kainook requires access to your photo library to allow you to select and upload your profile picture, as well as upload property or vehicle photos for your listings.",
        "NSPhotoLibraryAddUsageDescription": "Kainook requires permission to save photos to your photo library."
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "associatedDomains": [
        "applinks:kainook.com",
        "webcredentials:kainook.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.kainook.app",
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBtITwwJXuiQsjNusLT4CKheR5g_cd4QPA"
        }
      },
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kainook.com",
              "pathPrefix": "/verify"
            },
            {
              "scheme": "https",
              "host": "kainook.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "kainook.com",
              "pathPrefix": "/auth/verify"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "androidDefaultNotificationChannelId": "default",
          "androidDefaultNotificationColor": "#024622"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-apple-authentication"
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1022728776661-6aucvg2l0r7suuogj2m9lgcjodetb2rn"
        }
      ],
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.kainook.app"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Kainook uses your location to place your listing's map pin accurately when you are at the property."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Kainook requires access to your photo library to allow you to select and upload your profile picture, as well as upload property or vehicle photos for your listings.",
          "cameraPermission": "Kainook requires camera access to allow you to take and upload a profile picture, as well as take photos of your property or vehicle when creating a listing."
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/eb02914a-9afa-4816-8d96-31d713f19022"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb02914a-9afa-4816-8d96-31d713f19022"
      },
      "googleMapsApiKey": "AIzaSyBtITwwJXuiQsjNusLT4CKheR5g_cd4QPA"
    },
    "owner": "kainook.it"
  }
}
