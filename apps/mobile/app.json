{
  "expo": {
    "name": "Kainook",
    "slug": "kainook",
    "version": "1.0.0",
    "runtimeVersion": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "kainook",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.kainook.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "buildNumber": "1",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ]
      },
      "entitlements": {
        "aps-environment": "development",
        "com.apple.developer.applesignin": [
          "Default"
        ]
      },
      "associatedDomains": [
        "applinks:kainook.com",
        "webcredentials:kainook.com"
      ]
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.kainook.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.WAKE_LOCK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "kainook.com",
              "pathPrefix": "/verify"
            },
            {
              "scheme": "https",
              "host": "kainook.com",
              "pathPrefix": "/reset-password"
            },
            {
              "scheme": "https",
              "host": "kainook.com",
              "pathPrefix": "/auth/verify"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "@react-native-firebase/messaging",
        {
          "androidDefaultNotificationChannelId": "default",
          "androidDefaultNotificationColor": "#024622"
        }
      ],
      "expo-router",
      "expo-secure-store",
      [
        "expo-apple-authentication"
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.1022728776661-6aucvg2l0r7suuogj2m9lgcjodetb2rn"
        }
      ],
      "expo-font",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.kainook.app"
        }
      ]
    ],
    "updates": {
      "url": "https://u.expo.dev/eb02914a-9afa-4816-8d96-31d713f19022"
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "eb02914a-9afa-4816-8d96-31d713f19022"
      }
    },
    "owner": "kainook.it"
  }
}