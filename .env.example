# ── Database ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string used by all services via Turbo globalPassThroughEnv
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/zika_db_local"

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ────────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="change-me-to-a-long-random-string-min-64-chars"
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000

# ── Admin JWT ──────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET="change-me-admin-secret-min-64-chars"
ADMIN_INTERMEDIATE_TTL_SECONDS=300
ADMIN_SESSION_INACTIVITY_SECONDS=28800

# ── SendGrid ───────────────────────────────────────────────────────────────────
# Get from https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="noreply@yourdomain.com"
SENDGRID_FROM_NAME="ZikaBooking"

# ── App URLs ───────────────────────────────────────────────────────────────────
WEB_BASE_URL="http://localhost:3000"
ADMIN_BASE_URL="http://localhost:3002"
APP_DEEP_LINK_SCHEME="zikabooking"

# ── Google OAuth ───────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID_WEB="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret-here"
GOOGLE_CLIENT_ID_IOS="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_ANDROID="xxxx.apps.googleusercontent.com"

# ── Apple OAuth ────────────────────────────────────────────────────────────────
APPLE_CLIENT_ID="com.yourapp.bundle"
APPLE_TEAM_ID="XXXXXXXXXX"
APPLE_KEY_ID="XXXXXXXXXX"
APPLE_PRIVATE_KEY_PATH="./secrets/apple-auth.p8"

# ── TOTP / FIDO2 ───────────────────────────────────────────────────────────────
TOTP_ENCRYPTION_KEY="32-byte-hex-key-for-aes256-totp-secret-encryption"
WEBAUTHN_RP_ID="admin.yourdomain.com"
WEBAUTHN_RP_NAME="ZikaBooking Admin"
WEBAUTHN_ORIGIN="https://admin.yourdomain.com"

# ── Auth Service ───────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_HOST="0.0.0.0"
NODE_ENV="development"

# ── Listing Service ────────────────────────────────────────────────────────────
LISTING_SERVICE_PORT=3003
LISTING_SERVICE_HOST="0.0.0.0"

# ── Payment Service ────────────────────────────────────────────────────────────
PAYMENT_SERVICE_PORT=3004
PAYMENT_SERVICE_HOST="0.0.0.0"

# ── AWS S3 ─────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"
AWS_REGION="af-south-1"
S3_BUCKET_NAME="zika-storage"
S3_CDN_BASE_URL="https://zika-storage.s3.af-south-1.amazonaws.com"

# ── Google Maps ────────────────────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ── Next.js public env (web & admin) ──────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_LISTING_API_URL="http://localhost:3003"

# ── Expo public env (mobile) ───────────────────────────────────────────────────
# Leave these blank — the mobile app auto-detects the dev server host from the
# Expo QR code, so no IP address needs to be set manually.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_LISTING_API_URL=
EXPO_PUBLIC_PAYMENT_API_URL=
