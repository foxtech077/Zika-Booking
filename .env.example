# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/zika_booking"

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string-min-64-chars"
JWT_ACCESS_TTL_SECONDS=900         # 15 minutes
JWT_REFRESH_TTL_SECONDS=2592000    # 30 days

# ── Admin JWT ─────────────────────────────────────────────────────────────────
ADMIN_JWT_SECRET="change-me-admin-secret-min-64-chars"
ADMIN_INTERMEDIATE_TTL_SECONDS=300  # 5 minutes
ADMIN_SESSION_INACTIVITY_SECONDS=28800  # 8 hours

# ── SendGrid ──────────────────────────────────────────────────────────────────
SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxx"
SENDGRID_FROM_EMAIL="noreply@zikabooking.com"
SENDGRID_FROM_NAME="ZikaBooking"

# ── App URLs ──────────────────────────────────────────────────────────────────
WEB_BASE_URL="https://zikabooking.com"
ADMIN_BASE_URL="https://admin.zikabooking.com"
APP_DEEP_LINK_SCHEME="zikabooking"

# ── Google OAuth ──────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID_WEB="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_IOS="xxxx.apps.googleusercontent.com"
GOOGLE_CLIENT_ID_ANDROID="xxxx.apps.googleusercontent.com"

# ── Apple OAuth ───────────────────────────────────────────────────────────────
APPLE_CLIENT_ID="com.zikabooking.app"
APPLE_TEAM_ID="XXXXXXXXXX"
APPLE_KEY_ID="XXXXXXXXXX"
APPLE_PRIVATE_KEY_PATH="./secrets/apple-auth.p8"

# ── TOTP / FIDO2 ──────────────────────────────────────────────────────────────
TOTP_ENCRYPTION_KEY="32-byte-hex-key-for-aes256-totp-secret-encryption"
WEBAUTHN_RP_ID="admin.zikabooking.com"
WEBAUTHN_RP_NAME="ZikaBooking Admin"
WEBAUTHN_ORIGIN="https://admin.zikabooking.com"

# ── Auth Service ──────────────────────────────────────────────────────────────
AUTH_SERVICE_PORT=3001
AUTH_SERVICE_HOST="0.0.0.0"
NODE_ENV="development"

# ── Listing Service ───────────────────────────────────────────────────────────
LISTING_SERVICE_PORT=3003
LISTING_SERVICE_HOST="0.0.0.0"

# ── AWS S3 (photos & documents) ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID="AKIAIOSFODNN7EXAMPLE"
AWS_SECRET_ACCESS_KEY="wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
AWS_REGION="us-east-1"
S3_BUCKET_NAME="zika-listings-dev"
S3_CDN_BASE_URL="https://zika-listings-dev.s3.us-east-1.amazonaws.com"

# ── Google Maps (geocoding proxy in listing-service) ──────────────────────────
GOOGLE_MAPS_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# ── Next.js public env (web & admin) ─────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_LISTING_API_URL="http://localhost:3003"

# ── Expo public env (mobile) ──────────────────────────────────────────────────
EXPO_PUBLIC_API_URL="http://localhost:3001"
EXPO_PUBLIC_LISTING_API_URL="http://localhost:3003"
