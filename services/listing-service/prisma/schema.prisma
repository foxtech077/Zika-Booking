generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["listing", "auth"]
}

enum ListingCategory {
  hotel
  apartment
  car

  @@schema("listing")
}

enum ListingStatus {
  draft
  pending_review
  approved
  rejected
  active
  deactivated
  suspended
  auto_suspended
  permanently_banned

  @@schema("listing")
}

enum LongStayDiscountType {
  percentage
  fixed

  @@schema("listing")
}

enum Transmission {
  manual
  automatic
  semi_auto

  @@schema("listing")
}

enum FuelType {
  petrol
  diesel
  electric
  hybrid
  lpg

  @@schema("listing")
}

enum MileagePolicy {
  unlimited
  limited

  @@schema("listing")
}

enum RoomType {
  standard
  superior
  deluxe
  suite
  junior_suite
  studio
  family_roomgit 
  presidential_suite

  @@schema("listing")
}

enum CancellationPolicy {
  flexible
  moderate
  strict

  @@schema("listing")
}

enum DocumentType {
  business_licence
  operating_permit
  tourism_certificate
  insurance_certificate
  roadworthiness_certificate
  hotel_operating_permit
  tourism_authority_certificate
  vehicle_registration

  @@schema("listing")
}

enum CarCategory {
  Economy
  Compact
  SUV
  Minivan
  Pickup
  Luxury
  Electric
  Convertible

  @@schema("listing")
}

enum DriveType {
  TWO_WD   @map("2WD")
  FOUR_WD  @map("4WD")
  AWD      @map("AWD")

  @@schema("listing")
}

enum InsuranceType {
  basic
  standard
  premium
  comprehensive
  basic_third_party
  premium_zero_excess

  @@schema("listing")
}

enum FuelPolicy {
  full_to_full
  same_to_same
  free_tank
  full_to_empty
  pre_purchase

  @@schema("listing")
}

enum ReviewTaskStatus {
  open
  awaiting_provider_response
  resolved
  escalated

  @@schema("listing")
}

enum BedType {
  single
  double
  queen
  king
  twin

  @@schema("listing")
}

enum ApartmentType {
  entire_place
  private_room
  shared_room
  studio
  loft
  villa
  townhouse

  @@schema("listing")
}

enum BlockedDateSource {
  manual
  ical

  @@schema("listing")
}

model Listing {
  id                    String              @id @default(uuid())
  providerId            String              @map("provider_id")
  category              ListingCategory
  name                  String?             @db.VarChar(200)
  roomType              RoomType?           @map("room_type")
  unitCount             Int?                @map("unit_count")
  description           String?             @db.Text
  pricePerNight         Decimal?            @map("price_per_night") @db.Decimal(10, 2)
  pricePerDay           Decimal?            @map("price_per_day") @db.Decimal(10, 2)
  currency              String?             @db.Char(3)
  minStayNights         Int                 @default(1) @map("min_stay_nights")
  checkinTime           String?             @map("checkin_time") @db.VarChar(5)
  checkoutTime          String?             @map("checkout_time") @db.VarChar(5)
  cancellationPolicy    CancellationPolicy? @map("cancellation_policy")
  smokingAllowed        Boolean             @default(false) @map("smoking_allowed")
  petsAllowed           Boolean             @default(false) @map("pets_allowed")
  address               String?             @db.Text
  lat                   Decimal?            @db.Decimal(9, 6)
  lng                   Decimal?            @db.Decimal(9, 6)
  town                  String?             @db.VarChar(100)
  country               String?             @db.Char(2)
  claimedStarRating     Int?                @map("claimed_star_rating")
  starRating            Int?                @map("star_rating")
  status                ListingStatus       @default(draft)
  submissionCount       Int                 @default(0) @map("submission_count")
  submittedAt           DateTime?           @map("submitted_at")
  approvedAt            DateTime?           @map("approved_at")
  approvedBy            String?             @map("approved_by")
  rejectedAt            DateTime?           @map("rejected_at")
  rejectedBy            String?             @map("rejected_by")
  rejectionReasons      String[]            @map("rejection_reasons")
  rejectionNote         String?             @map("rejection_note") @db.Text
  suspendedAt           DateTime?           @map("suspended_at")
  suspendedBy           String?             @map("suspended_by")
  suspensionReason      String?             @map("suspension_reason") @db.Text
  consecutiveNegative   Int                 @default(0) @map("consecutive_negative_count")
  bedrooms              Int?
  bathrooms             Int?
  maxGuests             Int?                @map("max_guests")
  longStayEnabled       Boolean             @default(false) @map("long_stay_discount_enabled")
  longStayMinNights     Int?                @map("long_stay_min_nights")
  longStayDiscountType  LongStayDiscountType? @map("long_stay_discount_type")
  longStayDiscountValue Decimal?            @map("long_stay_discount_value") @db.Decimal(10, 2)
  activatedAt           DateTime?           @map("activated_at")
  carMake               String?             @map("car_make") @db.VarChar(80)
  carModel              String?             @map("car_model") @db.VarChar(80)
  carYear               Int?                @map("car_year")
  transmission          Transmission?
  fuelType              FuelType?           @map("fuel_type")
  seats                 Int?
  doors                 Int?                @default(4)
  mileagePolicy         MileagePolicy?      @map("mileage_policy")
  mileageLimitKm        Int?                @map("mileage_limit_km")
  carCategory           CarCategory?        @map("car_category")
  driveType             DriveType?          @map("drive_type")
  airConditioning       Boolean?            @map("air_conditioning")
  odometerReading       Int?                @map("odometer_reading")
  licencePlate          String?             @map("licence_plate") @db.VarChar(20)
  engineSize            String?             @map("engine_size") @db.VarChar(20)
  colour                String?             @map("colour") @db.VarChar(30)
  securityDeposit       Decimal?            @map("security_deposit") @db.Decimal(10, 2)
  minimumDriverAge      Int?                @map("minimum_driver_age")
  minimumRentalDays     Int?                @map("minimum_rental_days")
  fuelPolicy            FuelPolicy?         @map("fuel_policy")
  extraKmRate           Decimal?            @map("extra_km_rate") @db.Decimal(10, 2)
  roadsideAssistance    Boolean             @default(false) @map("roadside_assistance")
  crossBorderAllowed    Boolean             @default(false) @map("cross_border_allowed")
  airportPickup         Boolean             @default(false) @map("airport_pickup")
  deliveryEnabled       Boolean             @default(false) @map("delivery_enabled")
  deliveryRadiusKm      Int?                @map("delivery_radius_km")
  deliveryFee           Decimal?            @map("delivery_fee") @db.Decimal(10, 2)
  pickupHoursFrom       String?             @map("pickup_hours_from") @db.VarChar(5)
  pickupHoursTo         String?             @map("pickup_hours_to") @db.VarChar(5)
  returnSameLocation    Boolean             @default(true) @map("return_same_location")
  insuranceType         InsuranceType?      @map("insurance_type")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  deletedAt             DateTime?           @map("deleted_at")

  // ── Hotel extended fields ────────────────────────────────────────────────
  featuredPhotoId    String?  @map("featured_photo_id")
  maxAdults          Int?     @map("max_adults")
  maxChildren        Int?     @map("max_children")
  childrenAllowed    Boolean  @default(true) @map("children_allowed")
  childPriceType     String?  @map("child_price_type") @db.VarChar(20)
  childPriceValue    Decimal? @map("child_price_value") @db.Decimal(10, 2)
  childFreeUnderAge  Int?     @map("child_free_under_age")
  checkinRules       String?  @map("checkin_rules") @db.Text
  checkoutRules      String?  @map("checkout_rules") @db.Text
  earlyCheckinFee    Decimal? @map("early_checkin_fee") @db.Decimal(10, 2)
  lateCheckoutFee    Decimal? @map("late_checkout_fee") @db.Decimal(10, 2)

  // ── Apartment extended fields ────────────────────────────────────────────
  cleaningFee        Decimal?       @map("cleaning_fee") @db.Decimal(10, 2)
  extraGuestFee      Decimal?       @map("extra_guest_fee") @db.Decimal(10, 2)
  extraGuestAfter    Int?           @map("extra_guest_after")
  weeklyDiscount     Decimal?       @map("weekly_discount") @db.Decimal(5, 2)
  monthlyDiscount    Decimal?       @map("monthly_discount") @db.Decimal(5, 2)
  instantBooking     Boolean        @default(false) @map("instant_booking")
  selfCheckin        Boolean        @default(false) @map("self_checkin")
  selfCheckinDetails String?        @map("self_checkin_details") @db.Text
  apartmentType      ApartmentType? @map("apartment_type")
  floorNumber        Int?           @map("floor_number")
  propertySizeM2     Decimal?       @map("property_size_m2") @db.Decimal(8, 2)
  securityDepositDue String?        @map("security_deposit_due") @db.VarChar(30)

  photos          ListingPhoto[]
  documents       ListingDocument[]
  amenities       ListingAmenity[]
  customAmenities ListingCustomAmenity[]
  reviewTasks     ListingReviewTask[]
  favourites      UserFavourite[]
  recentViews     UserRecentlyViewed[]
  bookings        Booking[]
  reviews         ListingReview[]
  icalFeeds       IcalFeed[]
  moderationLogs  ListingModerationLog[]

  @@map("listings")
  @@schema("listing")
}

model ListingReviewTask {
  id               String           @id @default(uuid())
  listingId        String           @map("listing_id")
  submissionNumber Int              @map("submission_number")
  assignedTo       String?          @map("assigned_to")
  status           ReviewTaskStatus @default(open)
  outcome          String?
  adminNote        String?          @map("admin_note") @db.Text
  slaDeadline      DateTime         @map("sla_deadline")
  createdAt        DateTime         @default(now()) @map("created_at")
  resolvedAt       DateTime?        @map("resolved_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@map("listing_review_tasks")
  @@schema("listing")
}

model ListingPhoto {
  id          String    @id @default(uuid())
  listingId   String    @map("listing_id")
  s3Key       String    @map("s3_key") @db.VarChar(500)
  cdnUrl      String    @map("cdn_url") @db.VarChar(500)
  position    Int
  uploadedAt  DateTime  @default(now()) @map("uploaded_at")
  deletedAt   DateTime? @map("deleted_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@map("listing_photos")
  @@schema("listing")
}

model ListingDocument {
  id           String       @id @default(uuid())
  listingId    String       @map("listing_id")
  documentType DocumentType @map("document_type")
  s3Key        String       @map("s3_key") @db.VarChar(500)
  fileType     String       @map("file_type") @db.VarChar(10)
  uploadedAt   DateTime     @default(now()) @map("uploaded_at")
  replacedAt   DateTime?    @map("replaced_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@map("listing_documents")
  @@schema("listing")
}

model ListingAmenity {
  listingId  String @map("listing_id")
  amenityKey String @map("amenity_key") @db.VarChar(100)

  listing Listing @relation(fields: [listingId], references: [id])

  @@id([listingId, amenityKey])
  @@map("listing_amenities")
  @@schema("listing")
}

model ListingCustomAmenity {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  label     String   @db.VarChar(60)
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@map("listing_custom_amenities")
  @@schema("listing")
}

// ── E5 — Search & Discovery ───────────────────────────────────────────────────

model UserFavourite {
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("user_favourites")
  @@schema("listing")
}

model UserRecentlyViewed {
  userId    String   @map("user_id")
  listingId String   @map("listing_id")
  viewedAt  DateTime @default(now()) @map("viewed_at")

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@map("user_recently_viewed")
  @@schema("listing")
}

model SearchLog {
  id             String    @id @default(uuid())
  userId         String?   @map("user_id")
  category       String    @db.VarChar(20)
  placeName      String    @map("place_name") @db.Text
  lat            Decimal   @db.Decimal(10, 7)
  lng            Decimal   @db.Decimal(10, 7)
  radiusKm       Int       @default(25) @map("radius_km")
  checkIn        DateTime? @map("check_in") @db.Date
  checkOut       DateTime? @map("check_out") @db.Date
  pickupDatetime DateTime? @map("pickup_datetime")
  returnDatetime DateTime? @map("return_datetime")
  guests         Int?
  filtersApplied Json      @default("{}") @map("filters_applied")
  sortApplied    String    @default("recommended") @map("sort_applied") @db.VarChar(20)
  resultCount    Int       @default(0) @map("result_count")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@map("search_logs")
  @@schema("listing")
}

// ── E6 — Booking Engine ───────────────────────────────────────────────────────

enum BookingStatus {
  pending_payment
  confirmed
  completed
  cancelled_by_guest
  cancelled_by_provider
  cancelled_by_system

  @@schema("listing")
}

  model Booking {
    id          String        @id @default(uuid())
    reference   String        @unique @db.VarChar(25)
    listingId   String        @map("listing_id")
    guestId     String        @map("guest_id")
    providerId  String        @map("provider_id")
    listingType String        @map("listing_type") @db.VarChar(20)

    status BookingStatus @default(pending_payment)

    checkIn        DateTime? @map("check_in") @db.Date
    checkOut       DateTime? @map("check_out") @db.Date
    pickupDatetime DateTime? @map("pickup_datetime")
    returnDatetime DateTime? @map("return_datetime")
    nightsOrDays   Int       @map("nights_or_days")

    guestFirstName  String  @map("guest_first_name") @db.VarChar(100)
    guestLastName   String  @map("guest_last_name") @db.VarChar(100)
    guestEmail      String  @map("guest_email") @db.VarChar(255)
    guestPhone      String? @map("guest_phone") @db.VarChar(30)
    adults          Int?
    children        Int?    @default(0)
    specialRequests String? @map("special_requests") @db.Text

    driverFirstName   String?  @map("driver_first_name") @db.VarChar(100)
    driverLastName    String?  @map("driver_last_name") @db.VarChar(100)
    driverAge         Int?     @map("driver_age")
    deliveryRequested Boolean  @default(false) @map("delivery_requested")
    deliveryAddress   String?  @map("delivery_address") @db.Text

    nightlyRate     Decimal? @map("nightly_rate") @db.Decimal(12, 2)
    dailyRate       Decimal? @map("daily_rate") @db.Decimal(12, 2)
    subtotal        Decimal  @db.Decimal(12, 2)
    discountAmount  Decimal  @default(0) @map("discount_amount") @db.Decimal(12, 2)
    deliveryFee     Decimal  @default(0) @map("delivery_fee") @db.Decimal(12, 2)
    totalAmount     Decimal  @map("total_amount") @db.Decimal(12, 2)
    currency        String   @db.Char(3)
    securityDeposit Decimal? @map("security_deposit") @db.Decimal(12, 2)

    commissionRate   Decimal @map("commission_rate") @db.Decimal(6, 4)
    commissionAmount Decimal @map("commission_amount") @db.Decimal(12, 2)
    providerPayout   Decimal @map("provider_payout") @db.Decimal(12, 2)

    cancellationPolicy String  @map("cancellation_policy") @db.VarChar(20)
    refundAmount       Decimal? @map("refund_amount") @db.Decimal(12, 2)

    cancelledAt        DateTime? @map("cancelled_at")
    cancelledBy        String?   @map("cancelled_by") @db.VarChar(20)
    cancellationReason String?   @map("cancellation_reason") @db.Text

    paymentId   String?   @map("payment_id")
    confirmedAt DateTime? @map("confirmed_at")
    completedAt DateTime? @map("completed_at")
    createdAt   DateTime  @default(now()) @map("created_at")
    updatedAt   DateTime  @updatedAt @map("updated_at")

    voucherCode     String?  @map("voucher_code") @db.VarChar(30)
    voucherDiscount Decimal  @default(0) @map("voucher_discount") @db.Decimal(10, 2)

    listing   Listing            @relation(fields: [listingId], references: [id])
    statusLog BookingStatusLog[]
    review    ListingReview?

    @@map("bookings")
    @@schema("listing")
  }

  model BookingStatusLog {
    id         String   @id @default(uuid())
    bookingId  String   @map("booking_id")
    fromStatus String?  @map("from_status") @db.VarChar(30)
    toStatus   String   @map("to_status") @db.VarChar(30)
    changedBy  String?  @map("changed_by")
    actorType  String?  @map("actor_type") @db.VarChar(20)
    reason     String?  @db.Text
    createdAt  DateTime @default(now()) @map("created_at")

    booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

    @@map("booking_status_log")
    @@schema("listing")
  }

// ── E14 — Reviews ─────────────────────────────────────────────────────────────

model ListingReview {
  id               String    @id @default(uuid())
  bookingId        String    @unique @map("booking_id")
  listingId        String    @map("listing_id")
  guestId          String    @map("guest_id")
  rating           Int
  title            String?   @db.VarChar(100)
  body             String?   @db.Text
  providerReply    String?   @map("provider_reply") @db.Text
  providerRepliedAt DateTime? @map("provider_replied_at")
  isHidden         Boolean   @default(false) @map("is_hidden")
  hiddenBy         String?   @map("hidden_by")
  hiddenAt         DateTime? @map("hidden_at")
  hiddenReason     String?   @map("hidden_reason") @db.Text
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  listing Listing @relation(fields: [listingId], references: [id])
  booking Booking @relation(fields: [bookingId], references: [id])

  @@map("listing_reviews")
  @@schema("listing")
}

// ── E11 — Commission Management ───────────────────────────────────────────────


// ── E15 — Vouchers & Promotions ───────────────────────────────────────────────

enum VoucherDiscountType {
  percentage
  fixed

  @@schema("listing")
}

model Voucher {
  id                 String              @id @default(uuid())
  code               String              @unique @db.VarChar(30)
  title              String              @default("") @db.VarChar(100)
  description        String?             @db.VarChar(120)
  activityScope      String              @default("universal") @map("activity_scope") @db.VarChar(30)
  discountType       VoucherDiscountType @map("discount_type")
  discountValue      Decimal             @map("discount_value") @db.Decimal(10, 2)
  minOrderValue      Decimal?            @map("min_order_value") @db.Decimal(10, 2)
  maxDiscount        Decimal?            @map("max_discount") @db.Decimal(10, 2)
  usageLimit         Int?                @map("usage_limit")
  usageLimitPerGuest Int                 @default(1) @map("usage_limit_per_guest")
  usageCount         Int                 @default(0) @map("usage_count")
  status             String              @default("active") @db.VarChar(20)
  applicableTiers    String[]            @map("applicable_tiers")
  countryScope       String?             @map("country_scope") @db.Char(2)
  autoAssign         Boolean             @default(false) @map("auto_assign")
  validFrom          DateTime            @map("valid_from")
  validUntil         DateTime            @map("valid_until")
  createdBy          String              @map("created_by")
  isActive           Boolean             @default(true) @map("is_active")
  createdAt          DateTime            @default(now()) @map("created_at")

  redemptions VoucherRedemption[]

  @@map("vouchers")
  @@schema("listing")
}

model VoucherRedemption {
  id        String   @id @default(uuid())
  voucherId String   @map("voucher_id")
  bookingId String   @unique @map("booking_id")
  guestId   String   @map("guest_id")
  discount  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  voucher Voucher @relation(fields: [voucherId], references: [id])

  @@map("voucher_redemptions")
  @@schema("listing")
}

// ── E13 — iCal Sync ───────────────────────────────────────────────────────────

model IcalFeed {
  id                  String    @id @default(uuid())
  listingId           String    @map("listing_id")
  platform            String    @db.VarChar(50)
  feedUrl             String    @map("feed_url") @db.VarChar(1000)
  lastSyncedAt        DateTime? @map("last_synced_at")
  lastError           String?   @map("last_error") @db.Text
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  nextRetryAt         DateTime? @map("next_retry_at")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  listing      Listing          @relation(fields: [listingId], references: [id], onDelete: Cascade)
  blockedDates IcalBlockedDate[]

  @@map("ical_feeds")
  @@schema("listing")
}

model IcalBlockedDate {
  id        String   @id @default(uuid())
  feedId    String   @map("feed_id")
  listingId String   @map("listing_id")
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  summary   String?  @db.VarChar(500)
  uid       String?  @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  feed IcalFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)

  @@unique([feedId, uid])
  @@map("ical_blocked_dates")
  @@schema("listing")
}

// ── Moderation Audit Log ──────────────────────────────────────────────────────

model ListingModerationLog {
  id        String   @id @default(uuid())
  listingId String   @map("listing_id")
  action    String   @db.VarChar(50)
  actorId   String   @map("actor_id")
  actorRole String   @map("actor_role") @db.VarChar(50)
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")

  listing Listing @relation(fields: [listingId], references: [id])

  @@map("listing_moderation_log")
  @@schema("listing")
}

// ── E17 — In-App Messaging ────────────────────────────────────────────────────

enum ConversationStatus {
  open
  closed

  @@schema("listing")
}

model Conversation {
  id         String             @id @default(uuid())
  bookingId  String?            @unique @map("booking_id")
  listingId  String             @map("listing_id")
  guestId    String             @map("guest_id")
  providerId String             @map("provider_id")
  status     ConversationStatus @default(open)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  messages Message[]

  @@map("conversations")
  @@schema("listing")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String    @map("conversation_id")
  senderId       String    @map("sender_id")
  senderType     String    @map("sender_type") @db.VarChar(20)
  body           String    @db.Text
  isFiltered     Boolean   @default(false) @map("is_filtered")
  readAt         DateTime? @map("read_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("messages")
  @@schema("listing")
}

enum ReportStatus {
  pending
  investigating
  resolved
  dismissed

  @@schema("listing")
}

// ── E20 — User Reports ────────────────────────────────────────────────────────

model Report {
  id           String       @id @default(uuid())
  reporterId   String       @map("reporter_id")
  targetType   String       @map("target_type") @db.VarChar(50) // e.g. "listing", "user", "review"
  targetId     String       @map("target_id")
  reason       String       @db.VarChar(100)
  description  String?      @db.Text
  status       ReportStatus @default(pending)
  adminNote    String?      @map("admin_note") @db.Text
  resolvedAt   DateTime?    @map("resolved_at")
  resolvedBy   String?      @map("resolved_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  @@index([status])
  @@index([targetType, targetId])
  @@map("reports")
  @@schema("listing")
}

model AuditLog {
  id         String    @id @default(cuid())
  adminId    String
  role       String    @db.VarChar(50)
  action     String    @db.VarChar(100)
  targetType String?   @db.VarChar(50)
  targetId   String?
  oldValue   String?   @db.Text
  newValue   String?   @db.Text
  ipAddress  String    @db.VarChar(45)
  timestamp  DateTime  @default(now())

  @@map("AuditLog")
  @@schema("auth")
}

// ── E15 — Commission Management ───────────────────────────────────────────────

model PlatformSettings {
  id                   Int      @id @default(1)
  globalCommissionRate Decimal  @default(5.00) @map("global_commission_rate") @db.Decimal(5, 2)
  updatedAt            DateTime @updatedAt @map("updated_at")
  updatedBy            String   @map("updated_by") @db.VarChar(50)

  @@map("platform_settings")
  @@schema("listing")
}

model CountryCommission {
  id            String    @id @default(uuid())
  country       String    @unique @db.Char(2)
  currentRate   Decimal   @map("current_rate") @db.Decimal(5, 2)
  pendingRate   Decimal?  @map("pending_rate") @db.Decimal(5, 2)
  effectiveFrom DateTime? @map("effective_from")
  lastReason    String?   @map("last_reason") @db.VarChar(500)
  setBy         String    @map("set_by") @db.VarChar(50)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  @@map("country_commissions")
  @@schema("listing")
}

model CommissionHistory {
  id                String   @id @default(uuid())
  scope             String   @db.VarChar(10) // "global" or "country"
  countryCode       String?  @map("country_code") @db.Char(2)
  oldRate           Decimal? @map("old_rate") @db.Decimal(5, 2)
  newRate           Decimal  @map("new_rate") @db.Decimal(5, 2)
  effectiveFrom     DateTime @map("effective_from")
  changedBy         String   @map("changed_by") @db.VarChar(50)
  changedByRole     String   @map("changed_by_role") @db.VarChar(50)
  reason            String   @db.VarChar(500)
  applyToAll        Boolean  @map("apply_to_all")
  providersNotified Boolean  @map("providers_notified")
  createdAt         DateTime @default(now()) @map("created_at")

  @@map("commission_history")
  @@schema("listing")
}


