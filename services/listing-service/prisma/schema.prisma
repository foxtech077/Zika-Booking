generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ListingCategory {
  hotel
  apartment
  car
}

enum ListingStatus {
  draft
  pending_review
  approved
  rejected
  active
  deactivated
  suspended
  auto_suspended
  permanently_banned
}

enum LongStayDiscountType {
  percentage
  fixed
}

enum Transmission {
  manual
  automatic
  semi_auto
}

enum FuelType {
  petrol
  diesel
  electric
  hybrid
  lpg
}

enum MileagePolicy {
  unlimited
  limited
}

enum RoomType {
  standard
  superior
  deluxe
  suite
  junior_suite
  studio
  family_room
  presidential_suite
}

enum CancellationPolicy {
  flexible
  moderate
  strict
}

enum DocumentType {
  business_licence
  operating_permit
  tourism_certificate
  insurance_certificate
  roadworthiness_certificate
  hotel_operating_permit
  tourism_authority_certificate
  vehicle_registration
}

enum CarCategory {
  Economy
  Compact
  SUV
  Minivan
  Pickup
  Luxury
  Electric
  Convertible
}

enum DriveType {
  TWO_WD   @map("2WD")
  FOUR_WD  @map("4WD")
  AWD      @map("AWD")
}

enum InsuranceType {
  basic
  standard
  premium
  comprehensive
  basic_third_party
  premium_zero_excess
}

enum FuelPolicy {
  full_to_full
  same_to_same
  free_tank
  full_to_empty
  pre_purchase
}

enum ReviewTaskStatus {
  open
  awaiting_provider_response
  resolved
  escalated
}

enum BedType {
  single
  double
  queen
  king
  twin
}

enum ApartmentType {
  entire_place
  private_room
  shared_room
  studio
  loft
  villa
  townhouse
}

enum BlockedDateSource {
  manual
  ical
}

model Listing {
  id                    String              @id @default(uuid())
  providerId            String              @map("provider_id")
  category              ListingCategory
  name                  String?             @db.VarChar(200)
  roomType              RoomType?           @map("room_type")
  unitCount             Int?                @map("unit_count")
  description           String?             @db.Text
  pricePerNight         Decimal?            @map("price_per_night") @db.Decimal(10, 2)
  pricePerDay           Decimal?            @map("price_per_day") @db.Decimal(10, 2)
  currency              String?             @db.Char(3)
  minStayNights         Int                 @default(1) @map("min_stay_nights")
  checkinTime           String?             @map("checkin_time") @db.VarChar(5)
  checkoutTime          String?             @map("checkout_time") @db.VarChar(5)
  cancellationPolicy    CancellationPolicy? @map("cancellation_policy")
  smokingAllowed        Boolean             @default(false) @map("smoking_allowed")
  petsAllowed           Boolean             @default(false) @map("pets_allowed")
  address               String?             @db.Text
  lat                   Decimal?            @db.Decimal(9, 6)
  lng                   Decimal?            @db.Decimal(9, 6)
  town                  String?             @db.VarChar(100)
  country               String?             @db.Char(2)
  claimedStarRating     Int?                @map("claimed_star_rating")
  starRating            Int?                @map("star_rating")
  status                ListingStatus       @default(draft)
  submissionCount       Int                 @default(0) @map("submission_count")
  submittedAt           DateTime?           @map("submitted_at")
  approvedAt            DateTime?           @map("approved_at")
  approvedBy            String?             @map("approved_by")
  rejectedAt            DateTime?           @map("rejected_at")
  rejectedBy            String?             @map("rejected_by")
  rejectionReasons      String[]            @map("rejection_reasons")
  rejectionNote         String?             @map("rejection_note") @db.Text
  suspendedAt           DateTime?           @map("suspended_at")
  suspendedBy           String?             @map("suspended_by")
  suspensionReason      String?             @map("suspension_reason") @db.Text
  consecutiveNegative   Int                 @default(0) @map("consecutive_negative_count")
  bedrooms              Int?
  bathrooms             Int?
  maxGuests             Int?                @map("max_guests")
  longStayEnabled       Boolean             @default(false) @map("long_stay_discount_enabled")
  longStayMinNights     Int?                @map("long_stay_min_nights")
  longStayDiscountType  LongStayDiscountType? @map("long_stay_discount_type")
  longStayDiscountValue Decimal?            @map("long_stay_discount_value") @db.Decimal(10, 2)
  activatedAt           DateTime?           @map("activated_at")
  carMake               String?             @map("car_make") @db.VarChar(80)
  carModel              String?             @map("car_model") @db.VarChar(80)
  carYear               Int?                @map("car_year")
  transmission          Transmission?
  fuelType              FuelType?           @map("fuel_type")
  seats                 Int?
  doors                 Int?                @default(4)
  mileagePolicy         MileagePolicy?      @map("mileage_policy")
  mileageLimitKm        Int?                @map("mileage_limit_km")
  carCategory           CarCategory?        @map("car_category")
  driveType             DriveType?          @map("drive_type")
  airConditioning       Boolean?            @map("air_conditioning")
  odometerReading       Int?                @map("odometer_reading")
  licencePlate          String?             @map("licence_plate") @db.VarChar(20)
  engineSize            String?             @map("engine_size") @db.VarChar(20)
  colour                String?             @map("colour") @db.VarChar(30)
  securityDeposit       Decimal?            @map("security_deposit") @db.Decimal(10, 2)
  minimumDriverAge      Int?                @map("minimum_driver_age")
  minimumRentalDays     Int?                @map("minimum_rental_days")
  fuelPolicy            FuelPolicy?         @map("fuel_policy")
  extraKmRate           Decimal?            @map("extra_km_rate") @db.Decimal(10, 2)
  roadsideAssistance    Boolean             @default(false) @map("roadside_assistance")
  crossBorderAllowed    Boolean             @default(false) @map("cross_border_allowed")
  airportPickup         Boolean             @default(false) @map("airport_pickup")
  deliveryEnabled       Boolean             @default(false) @map("delivery_enabled")
  deliveryRadiusKm      Int?                @map("delivery_radius_km")
  deliveryFee           Decimal?            @map("delivery_fee") @db.Decimal(10, 2)
  pickupHoursFrom       String?             @map("pickup_hours_from") @db.VarChar(5)
  pickupHoursTo         String?             @map("pickup_hours_to") @db.VarChar(5)
  returnSameLocation    Boolean             @default(true) @map("return_same_location")
  insuranceType         InsuranceType?      @map("insurance_type")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  createdAt             DateTime            @default(now()) @map("created_at")
  deletedAt             DateTime?           @map("deleted_at")

  // ── Hotel extended fields ────────────────────────────────────────────────
  featuredPhotoId    String?  @map("featured_photo_id")
  maxAdults          Int?     @map("max_adults")
  maxChildren        Int?     @map("max_children")
  childrenAllowed    Boolean  @default(true) @map("children_allowed")
  childPriceType     String?  @map("child_price_type") @db.VarChar(20)
  childPriceValue    Decimal? @map("child_price_value") @db.Decimal(10, 2)
  childFreeUnderAge  Int?     @map("child_free_under_age")
  checkinRules       String?  @map("checkin_rules") @db.Text
  checkoutRules      String?  @map("checkout_rules") @db.Text
  earlyCheckinFee    Decimal? @map("early_checkin_fee") @db.Decimal(10, 2)
  lateCheckoutFee    Decimal? @map("late_checkout_fee") @db.Decimal(10, 2)

  // ── Apartment extended fields ────────────────────────────────────────────
  cleaningFee        Decimal?       @map("cleaning_fee") @db.Decimal(10, 2)
  extraGuestFee      Decimal?       @map("extra_guest_fee") @db.Decimal(10, 2)
  extraGuestAfter    Int?           @map("extra_guest_after")
  weeklyDiscount     Decimal?       @map("weekly_discount") @db.Decimal(5, 2)
  monthlyDiscount    Decimal?       @map("monthly_discount") @db.Decimal(5, 2)
  instantBooking     Boolean        @default(false) @map("instant_booking")
  selfCheckin        Boolean        @default(false) @map("self_checkin")
  selfCheckinDetails String?        @map("self_checkin_details") @db.Text
  apartmentType      ApartmentType? @map("apartment_type")
  floorNumber        Int?           @map("floor_number")
  propertySizeM2     Decimal?       @map("property_size_m2") @db.Decimal(8, 2)
  securityDepositDue String?        @map("security_deposit_due") @db.VarChar(30)

  photos          ListingPhoto[]
  documents       ListingDocument[]
  amenities       ListingAmenity[]
  customAmenities ListingCustomAmenity[]
  reviewTasks     ListingReviewTask[]
  moderationLog   ListingMod