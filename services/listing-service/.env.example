# ── Listing Service database connection ───────────────────────────────────────
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/zika_db_local?schema=listing"

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── AWS S3 (photos & documents) ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_KEY"
AWS_REGION="af-south-1"
S3_BUCKET_NAME="zika-storage"
S3_CDN_BASE_URL="https://zika-storage.s3.af-south-1.amazonaws.com"
