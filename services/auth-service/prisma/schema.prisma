generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  firstName          String              @db.VarChar(100)
  lastName           String              @db.VarChar(100)
  email              String              @unique @db.VarChar(255)
  passwordHash       String?             @db.VarChar(255)
  status             UserStatus          @default(pending_verification)
  userType           UserType
  businessName       String?             @db.VarChar(255)
  country            String?             @db.Char(2)
  emailVerified      Boolean             @default(false)
  emailVerifiedAt    DateTime?
  oauthProvider      OAuthProvider?
  oauthSub           String?             @db.VarChar(255)
  oauthRevoked       Boolean             @default(false)
  currentTier        LoyaltyTier         @default(bronze)
  loyaltyPoints      Int                 @default(0)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  emailLogs          EmailLog[]
  sessions           Session[]
  verificationTokens VerificationToken[]

  @@unique([oauthProvider, oauthSub])
  @@index([email])
  @@index([status])
}

model VerificationToken {
  id                String    @id @default(cuid())
  userId            String
  tokenHash         String    @unique @db.Char(64)
  tokenType         TokenType
  expiresAt         DateTime
  used              Boolean   @default(false)
  usedAt            DateTime?
  invalidatedReason String?   @db.VarChar(50)
  createdAt         DateTime  @default(now())
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, tokenType])
  @@index([expiresAt])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique @db.Char(64)
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model EmailLog {
  id            String         @id @default(cuid())
  userId        String?
  type          EmailLogType
  recipient     String         @db.VarChar(255)
  status        EmailLogStatus @default(sent)
  sendgridMsgId String?        @db.VarChar(255)
  sentAt        DateTime?
  createdAt     DateTime       @default(now())
  user          User?          @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([recipient])
}

model AdminUser {
  id                  String              @id @default(cuid())
  name                String              @db.VarChar(200)
  email               String              @unique @db.VarChar(255)
  passwordHash        String              @db.VarChar(255)
  role                AdminRole
  countryScope        String[]            @default([])
  totpEnabled         Boolean             @default(false)
  totpSecretEncrypted String?
  fido2Credential     Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  cancellationCount   Int                 @default(0)
  recoveryCodes       AdminRecoveryCode[]
  adminSessions       AdminSession[]
  auditLogs           AuditLog[]

  @@index([email])
  @@index([role])
}

model AdminSession {
  id           String    @id @default(cuid())
  adminUserId  String
  tokenHash    String    @unique @db.Char(64)
  revoked      Boolean   @default(false)
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AdminRecoveryCode {
  id          String    @id @default(cuid())
  adminUserId String
  codeHash    String    @db.Char(64)
  usedAt      DateTime?
  createdAt   DateTime  @default(now())
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId])
}

model AuditLog {
  id         String    @id @default(cuid())
  adminId    String
  role       String    @db.VarChar(50)
  action     String    @db.VarChar(100)
  targetType String?   @db.VarChar(50)
  targetId   String?
  oldValue   String?
  newValue   String?
  ipAddress  String    @db.VarChar(45)
  timestamp  DateTime  @default(now())
  admin      AdminUser @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetId])
  @@index([timestamp])
}

enum UserStatus {
  pending_verification
  active
  suspended
  banned
}

enum UserType {
  guest
  provider
}

enum OAuthProvider {
  google
  apple
}

enum LoyaltyTier {
  bronze
  silver
  gold
  diamond
}

enum TokenType {
  email_verification
  password_reset
}

enum EmailLogType {
  verification
  verification_resend
  welcome
  password_reset
  account_suspended
  account_reinstated
  account_banned
}

enum EmailLogStatus {
  sent
  failed
  bounced
}

enum AdminRole {
  super_admin
  admin
  country_manager
  sales
  support
  finance
}
