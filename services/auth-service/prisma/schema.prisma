// This is the Prisma schema for the ZikaBooking auth service.
// Run: pnpm db:generate  →  regenerates the Prisma client
// Run: pnpm db:migrate   →  applies pending migrations to the DB

generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["auth"]
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum UserStatus {
  pending_verification
  active
  suspended
  banned

  @@schema("auth")
}

enum AccreditationStatus {
  pending
  approved
  rejected

  @@schema("auth")
}

enum UserType {
  guest
  provider

  @@schema("auth")
}

enum OAuthProvider {
  google
  apple

  @@schema("auth")
}

enum LoyaltyTier {
  bronze
  silver
  gold
  diamond

  @@schema("auth")
}

enum TokenType {
  email_verification
  password_reset

  @@schema("auth")
}

enum EmailLogType {
  verification
  verification_resend
  welcome
  password_reset
  account_suspended
  account_reinstated
  account_banned

  @@schema("auth")
}

enum EmailLogStatus {
  sent
  failed
  bounced

  @@schema("auth")
}

enum AdminRole {
  super_admin
  admin
  country_manager
  sales
  support
  finance

  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Users (guests and providers)
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id              String        @id @default(cuid())
  firstName       String        @db.VarChar(100)
  lastName        String        @db.VarChar(100)
  email           String        @unique @db.VarChar(255)
  passwordHash    String?       @db.VarChar(255)   // null for OAuth-only accounts
  status          UserStatus    @default(pending_verification)
  userType        UserType
  businessName    String?       @db.VarChar(255)   // providers only
  country         String?       @db.Char(2)         // providers only (ISO 3166-1)
  emailVerified   Boolean       @default(false)
  emailVerifiedAt DateTime?
  oauthProvider   OAuthProvider?
  oauthSub        String?       @db.VarChar(255)
  oauthRevoked    Boolean       @default(false)
  currentTier     LoyaltyTier   @default(bronze)
  loyaltyPoints   Int           @default(0)
  photoUrl        String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  // Relations
  verificationTokens   VerificationToken[]
  sessions             Session[]
  emailLogs            EmailLog[]
  accreditation        Accreditation?
  notifications        Notification[]
  deviceTokens         DeviceToken[]
  loyaltyTransactions  LoyaltyTransaction[]

  @@unique([oauthProvider, oauthSub])
  @@index([email])
  @@index([status])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Loyalty transaction ledger
// ─────────────────────────────────────────────────────────────────────────────

model LoyaltyTransaction {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  // earned | redeemed | reversed_earned | refunded_redeemed | admin_adjustment
  type        String   @db.VarChar(30)
  points      Int
  balanceAfter Int     @map("balance_after")
  bookingId   String?  @map("booking_id") @db.VarChar(255)
  description String?  @db.VarChar(255)
  createdAt   DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([bookingId])
  @@map("loyalty_transactions")
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Email verification & password reset tokens
// ─────────────────────────────────────────────────────────────────────────────

model VerificationToken {
  id                 String     @id @default(cuid())
  userId             String
  user               User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash          String     @unique @db.Char(64)  // SHA-256 of plain token
  tokenType          TokenType
  expiresAt          DateTime
  used               Boolean    @default(false)
  usedAt             DateTime?
  invalidatedReason  String?    @db.VarChar(50)       // 'superseded' | 'expired'
  createdAt          DateTime   @default(now())

  @@index([userId, tokenType])
  @@index([expiresAt])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Guest / provider refresh token sessions
// ─────────────────────────────────────────────────────────────────────────────

model Session {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique @db.Char(64)   // SHA-256 of refresh token
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Email log
// ─────────────────────────────────────────────────────────────────────────────

model EmailLog {
  id               String         @id @default(cuid())
  userId           String?
  user             User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  type             EmailLogType
  recipient        String         @db.VarChar(255)
  status           EmailLogStatus @default(sent)
  sendgridMsgId    String?        @db.VarChar(255)
  sentAt           DateTime?
  createdAt        DateTime       @default(now())

  @@index([userId])
  @@index([recipient])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin users
// ─────────────────────────────────────────────────────────────────────────────

model AdminUser {
  id                  String      @id @default(cuid())
  name                String      @db.VarChar(200)
  email               String      @unique @db.VarChar(255)
  passwordHash        String      @db.VarChar(255)
  role                AdminRole
  countryScope        String[]    @default([])         // ISO 3166-1 codes; empty = global
  totpEnabled         Boolean     @default(false)
  totpSecretEncrypted String?     @db.Text             // AES-256 encrypted TOTP secret
  fido2Credential     Json?                            // public key + credential ID (super_admin)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  cancellationCount   Int         @default(0)

  // Relations
  adminSessions    AdminSession[]
  recoveryCodes    AdminRecoveryCode[]
  auditLogs        AuditLog[]

  @@index([email])
  @@index([role])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Admin sessions (replaces short-lived JWT for admin panel)
// Inactivity expiry of 8 hours enforced by lastActiveAt check (BR-1.11)
// ─────────────────────────────────────────────────────────────────────────────

model AdminSession {
  id           String    @id @default(cuid())
  adminUserId  String
  adminUser    AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique @db.Char(64)
  revoked      Boolean   @default(false)
  lastActiveAt DateTime  @default(now())
  createdAt    DateTime  @default(now())
  expiresAt    DateTime

  @@index([adminUserId])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// TOTP one-time recovery codes (8 codes per admin, single-use)
// ─────────────────────────────────────────────────────────────────────────────

model AdminRecoveryCode {
  id          String    @id @default(cuid())
  adminUserId String
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  codeHash    String    @db.Char(64)   // SHA-256 of plain code
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([adminUserId])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit log — immutable; no UPDATE or DELETE permitted (7-year retention)
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String    @id @default(cuid())
  adminId    String
  admin      AdminUser @relation(fields: [adminId], references: [id])
  role       String    @db.VarChar(50)
  action     String    @db.VarChar(100)
  targetType String?   @db.VarChar(50)
  targetId   String?
  oldValue   String?   @db.Text
  newValue   String?   @db.Text
  ipAddress  String    @db.VarChar(45)
  timestamp  DateTime  @default(now())

  @@index([adminId])
  @@index([targetId])
  @@index([timestamp])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Provider Accreditations
// ─────────────────────────────────────────────────────────────────────────────

model Accreditation {
  id              String              @id @default(cuid())
  providerId      String              @unique
  user            User                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  status          AccreditationStatus @default(pending)
  businessName    String?             @db.VarChar(255)
  registrationNo  String?             @db.VarChar(100)
  taxId           String?             @db.VarChar(100)
  documentsUrl    String?             @db.Text
  submittedAt     DateTime            @default(now())
  reviewedAt      DateTime?
  reviewedBy      String?
  rejectionReason String?             @db.Text
  updatedAt       DateTime            @updatedAt

  @@index([status])
  @@schema("auth")
}

// ─────────────────────────────────────────────────────────────────────────────
// Notifications
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(100)
  body      String   @db.Text
  isRead    Boolean  @default(false)
  data      Json?    @default("{}")
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@schema("auth")
}

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @db.VarChar(500)
  platform  String   @db.VarChar(10)
  createdAt DateTime @default(now())

  @@unique([userId, token])
  @@index([userId])
  @@schema("auth")
}
