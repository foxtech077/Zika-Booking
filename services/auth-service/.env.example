# ── Auth Service database connection ──────────────────────────────────────────
# Use a separate schema so auth tables don't collide with other services.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA_NAME
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/zika_db_local?schema=auth"

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"
