# ── Auth Service database connection ──────────────────────────────────────────
# Use a separate schema so auth tables don't collide with other services.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA_NAME
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/zika_db_local?schema=auth"

# ── Redis ──────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ── Skip Email Verification ────────────────────────────────────────────────────
SKIP_EMAIL_VERIFICATION=false

# ── Guest checkout (no sign-in) ────────────────────────────────────────────────
# TTL (seconds) for stateless guest tokens minted by POST /auth/guest-token.
# Must cover the whole lock → payment flow since guests have no refresh token.
JWT_GUEST_ACCESS_TTL_SECONDS=1800

# Listing service base URL — used to adopt anonymous bookings (bookings/claim)
# after a successful login/register. Best-effort; auth never fails if unreachable.
LISTING_API_URL=http://localhost:3003

# ── Internal service key ───────────────────────────────────────────────────────
# Shared secret used to authenticate service-to-service calls (e.g. the admin
# session introspection endpoint consumed by the payment/listing services).
INTERNAL_SERVICE_KEY="change-me-internal-service-key"

