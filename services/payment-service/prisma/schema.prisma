generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["payments"]
}

enum PaymentProvider {
  stripe
  tara

  @@schema("payments")
}

enum MerchantPayoutMethod {
  stripe_connect
  mobile_money
  bank_transfer
  manual

  @@schema("payments")
}

enum PayoutStatus {
  scheduled
  processing
  paid
  failed
  cancelled

  @@schema("payments")
}

enum PaymentStatus {
  initiated
  pending
  captured
  failed
  timed_out
  refunded

  @@schema("payments")
}

enum RefundStatus {
  pending
  submitted
  succeeded
  failed

  @@schema("payments")
}

model Payment {
  id                  String          @id @default(uuid())
  bookingId           String
  paymentProvider     PaymentProvider
  status              PaymentStatus   @default(initiated)
  attemptNumber       Int             @default(1)
  idempotencyKey      String          @unique
  providerPaymentId   String?
  providerPmId        String?
  amount              Decimal         @db.Decimal(12, 2)
  currency            String          @db.Char(3)
  paymentMethodType   String?
  cardBrand           String?
  cardLast4           String?         @db.Char(4)
  mobileNumberMasked  String?
  failureCode         String?
  failureMessage      String?
  capturedAt          DateTime?
  voucherGenerated    Boolean         @default(false)
  confirmationEmailsSent Boolean      @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  refund              Refund?

  @@index([bookingId, attemptNumber(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@schema("payments")
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String       @unique
  bookingId        String
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @db.Char(3)
  status           RefundStatus @default(pending)
  reason           String?
  providerRefundId String?
  failureReason    String?
  refundedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  payment          Payment      @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@index([status, createdAt(sort: Desc)])
  @@schema("payments")
}

model PaymentMethod {
  id                    String          @id @default(uuid())
  userId                String
  paymentProvider       PaymentProvider
  type                  String
  providerPmId          String?
  cardBrand             String?
  cardLast4             String?         @db.Char(4)
  cardExpMonth          Int?
  cardExpYear           Int?
  mobileNumberMasked    String?
  isDefault             Boolean         @default(false)
  isDeleted             Boolean         @default(false)
  createdAt             DateTime        @default(now())

  @@index([userId, isDeleted])
  @@schema("payments")
}

model CustomerAccount {
  id                 String          @id @default(uuid())
  userId             String
  paymentProvider    PaymentProvider
  providerCustomerId String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([userId, paymentProvider])
  @@index([userId])
  @@schema("payments")
}

model Merchant {
  id                     String               @id @default(uuid())
  userId                 String               @unique
  businessName           String?
  country                String?
  payoutMethod           MerchantPayoutMethod @default(manual)
  stripeConnectAccountId String?
  mobileMoneyNumber      String?
  bankName               String?
  bankAccountNumber      String?
  bankAccountName        String?
  isVerified             Boolean              @default(false)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  payouts                Payout[]

  @@index([userId])
  @@schema("payments")
}

model Payout {
  id               String        @id @default(uuid())
  merchantId       String
  bookingId        String        @unique
  providerId       String
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @db.Char(3)
  status           PayoutStatus  @default(scheduled)
  scheduledAt      DateTime
  processedAt      DateTime?
  providerPayoutId String?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  merchant         Merchant      @relation(fields: [merchantId], references: [id])

  @@index([status, scheduledAt])
  @@index([merchantId])
  @@index([providerId])
  @@schema("payments")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@schema("payments")
}
