generator client {
  provider      = "prisma-client-js"
  output        = "../src/generated"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["payments", "auth"]
}

enum PaymentProvider {
  stripe
  tara

  @@schema("payments")
}

enum MerchantPayoutMethod {
  stripe_connect
  mobile_money
  bank_transfer
  manual

  @@schema("payments")
}

enum PayoutStatus {
  pending
  scheduled
  processing
  paid
  failed
  cancelled

  @@schema("payments")
}

enum PaymentStatus {
  initiated
  pending
  captured
  failed
  timed_out
  partially_refunded
  refunded

  @@schema("payments")
}

enum RefundStatus {
  pending
  submitted
  succeeded
  failed

  @@schema("payments")
}

model Payment {
  id                  String          @id @default(uuid())
  displayId           String?         @unique
  bookingId           String
  paymentProvider     PaymentProvider
  status              PaymentStatus   @default(initiated)
  attemptNumber       Int             @default(1)
  idempotencyKey      String          @unique
  providerPaymentId   String?
  providerPmId        String?
  amount              Decimal         @db.Decimal(12, 2)
  currency            String          @db.Char(3)
  chargedAmount       Decimal?        @db.Decimal(12, 2)
  chargedCurrency     String?         @db.Char(3)
  chargedRate         Decimal?        @db.Decimal(16, 8)
  paymentMethodType   String?
  cardBrand           String?
  cardLast4           String?         @db.Char(4)
  mobileNumberMasked  String?
  failureCode         String?
  failureMessage      String?
  capturedAt          DateTime?
  voucherGenerated    Boolean         @default(false)
  confirmationEmailsSent Boolean      @default(false)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  refunds             Refund[]

  @@index([bookingId, attemptNumber(sort: Desc)])
  @@index([status, createdAt(sort: Desc)])
  @@schema("payments")
}

model Refund {
  id               String       @id @default(uuid())
  paymentId        String       @map("payment_id")
  bookingId        String       @map("booking_id")
  amount           Decimal      @db.Decimal(12, 2)
  currency         String       @db.Char(3)
  status           RefundStatus @default(pending)
  reason           String?
  providerRefundId String?       @map("provider_refund_id")
  failureReason    String?       @map("failure_reason")
  refundedAt       DateTime?     @map("refunded_at")
  idempotencyKey   String?      @unique @map("idempotency_key")
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")
  payment          Payment      @relation(fields: [paymentId], references: [id])

  @@index([bookingId])
  @@index([status, createdAt(sort: Desc)])
  @@schema("payments")
}

model PaymentMethod {
  id                    String          @id @default(uuid())
  userId                String
  paymentProvider       PaymentProvider
  type                  String
  providerPmId          String?
  cardBrand             String?
  cardLast4             String?         @db.Char(4)
  cardExpMonth          Int?
  cardExpYear           Int?
  mobileNumberMasked    String?
  isDefault             Boolean         @default(false)
  isDeleted             Boolean         @default(false)
  createdAt             DateTime        @default(now())

  @@index([userId, isDeleted])
  @@schema("payments")
}

model CustomerAccount {
  id                 String          @id @default(uuid())
  userId             String
  paymentProvider    PaymentProvider
  providerCustomerId String
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@unique([userId, paymentProvider])
  @@index([userId])
  @@schema("payments")
}

model Merchant {
  id                     String               @id @default(uuid())
  userId                 String               @unique
  businessName           String?
  country                String?
  payoutMethod           MerchantPayoutMethod @default(manual)
  stripeConnectAccountId String?
  mobileMoneyNumber      String?
  bankName               String?
  bankAccountNumber      String?
  bankAccountName        String?
  isVerified             Boolean              @default(false)
  isActive               Boolean              @default(true)
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt
  payouts                Payout[]

  @@index([userId])
  @@schema("payments")
}

model Payout {
  id               String        @id @default(uuid())
  merchantId       String
  bookingId        String        @unique
  providerId       String
  amount           Decimal       @db.Decimal(12, 2)
  currency         String        @db.Char(3)
  // Money-amount + currency snapshot captured at payout time (listing/base
  // detail plus the EUR transferred equivalent).
  priceBreakdownJson Json?       @map("price_breakdown_json")
  status           PayoutStatus  @default(pending)
  scheduledAt      DateTime?
  processedAt      DateTime?
  providerPayoutId String?
  failureReason    String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  merchant         Merchant      @relation(fields: [merchantId], references: [id])

  @@index([status, scheduledAt])
  @@index([merchantId])
  @@index([providerId])
  @@schema("payments")
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())

  @@schema("payments")
}

enum RefundRetryStatus {
  pending
  processing
  completed
  failed

  @@schema("payments")
}

model RefundNotificationRetry {
  id          String            @id @default(uuid())
  refundId    String            @unique @map("refund_id")
  bookingId   String            @map("booking_id")
  amount      Decimal           @db.Decimal(12, 2)
  provider    String
  refundedAt  DateTime          @map("refunded_at")
  status      RefundRetryStatus @default(pending)
  attempts    Int               @default(0)
  lastAttempt DateTime?         @map("last_attempt")
  nextAttempt DateTime?         @map("next_attempt")
  failedAt    DateTime?         @map("failed_at")
  createdAt   DateTime          @default(now()) @map("created_at")

  @@schema("payments")
}
